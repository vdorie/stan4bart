# pre-release lockstep guard: MAJOR/MINOR do not move before 1.0-0, so only the
# token catches a stale binary; dropped at the coordinated 1.0 merge
PKG_CPPFLAGS = -I"include" -I"../inst/include" -DEIGEN_NO_DEBUG -DDBARTS_USE_STUBS -DDBARTS_REQUIRE_EXACT_ABI

CXX_STD = CXX20
SOURCES = bart_util.cpp init.cpp logdensity_export.cpp parametric_control.cpp rc_bounds.c rc_util.c walnuts_sampler.cpp
OBJECTS = bart_util.o init.o logdensity_export.o parametric_control.o rc_bounds.o rc_util.o walnuts_sampler.o

AR = gcc-ar -m$(WIN)
NM = gcc-nm -m$(WIN)
RANLIB = gcc-ranlib -m$(WIN)

all: $(SHLIB)

clean:
		RM -rf *.so *.o

.phony: all clean
